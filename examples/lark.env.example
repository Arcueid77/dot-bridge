AUTH_MODE=tunnel-service
BRIDGE_MODE=tunnel
TUNNEL_SERVICE_OPERATION=live
TUNNEL_SERVICE_OWNER_ID=tunnel-owner:dot-bridge
HOST=127.0.0.1
PORT=8788
TUNNEL_SERVICE_KEY_FILE=/var/lib/dot-bridge/private/keys/lark-service-key
LARK_TRANSPORT=long-connection
LARK_CREDENTIALS_FILE=/var/lib/dot-bridge/private/lark-paired.json
LARK_EXPECTED_APP_ID=REPLACE_WITH_YOUR_VERIFIED_APP_ID
STORAGE_KEY_FILE=/var/lib/dot-bridge/private/keys/storage-key
DATABASE_PATH=/var/lib/dot-bridge/lark/bridge.sqlite
BRIDGE_LOCK_DIRECTORY=/var/lib/dot-bridge/locks
CALLBACK_TRANSPORT_MODE=standard
# Add only the callback hostname produced by the original dot's real subscription.
# MCP_CALLBACK_ALLOWED_HOSTS=
# Optional, after configuring the component's media policy:
# LARK_INTERACTION_POLICY_FILE=/var/lib/dot-bridge/private/lark-interactions.json
